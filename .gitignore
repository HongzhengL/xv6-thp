# Ignore TeX-related files
*.tex
*.dvi
*.idx
*.aux
*.log
*.ind
*.ilg

# Ignore object and assembly files
*.o
*.d
*.asm
*.sym

# Ignore source and build artifacts
vectors.S
bootblock
entryother
initcode
initcode.out
kernel
xv6.img
fs.img
kernelmemfs
xv6memfs.img
mkfs

# Ignore GDB configuration file
.gdbinit

# Ignore user programs
_*

# Ignore tests folder
tests/

# Ignore file generated by tests
test_*
Makefile.test

# Ignore file generated by clangd
compile_commands.json

